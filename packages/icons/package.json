{
  "name": "@m3-baseui/icons",
  "version": "2.0.0",
  "description": "Material Symbols as inline SVG — optional, no webfont required.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otomatty/m3-baseui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/otomatty/m3-baseui#readme",
  "bugs": {
    "url": "https://github.com/otomatty/m3-baseui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@m3/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "@m3/source": "./src/all.tsx",
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "bun run scripts/gen-glyphs.ts",
    "build": "bun run gen && tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.1"
  }
}

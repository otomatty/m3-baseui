---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { COMPONENT_GROUPS } from '../../../config/docs-nav';
import { COMPONENT_DOCS } from '../../../data/components';
---

<DocsLayout
  title="コンポーネント一覧"
  description="m3-baseui の全コンポーネント API リファレンスと実装例。"
>
  <h1>コンポーネント</h1>
  <p class="doc-lead">
    公開 API の全 {COMPONENT_DOCS.length} コンポーネントです。
    各ページに import 例・使用例・主要 props を掲載しています。
    ライブデモがあるコンポーネントはページ内で操作できます。
  </p>

  {
    COMPONENT_GROUPS.map((group) => (
      <section class="doc-section">
        <h2>{group.title}</h2>
        <div class="doc-card-grid">
          {group.items.map((item) => {
            const slug = item.href.replace('/docs/components/', '');
            const doc = COMPONENT_DOCS.find((d) => d.slug === slug);
            return (
              <a href={item.href} class="doc-card">
                <p class="doc-card__title">{item.label}</p>
                {doc && <p class="doc-card__body">{doc.description}</p>}
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
</DocsLayout>

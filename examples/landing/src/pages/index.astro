---
import SiteLayout from '../layouts/SiteLayout.astro';
import { LiveDemo } from '../components/LiveDemo';

const title = 'm3-baseui — Base UI 上の Material Design 3 コンポーネント';
const description =
  'Base UI をベースに Material Design 3 を実装した React コンポーネントライブラリ。vanilla-extract と Tailwind CSS v4 の両エンジンに drop-in 互換で対応し、動的配色・アクセシビリティに対応します。';

const lead =
  'M3 準拠の React コンポーネントを、Tailwind CSS v4 または vanilla-extract から drop-in で使えます。';

const nextSteps = [
  {
    href: '/docs/getting-started',
    title: '導入',
    body: 'インストール、CSS 配線、ThemeProvider の設定手順。',
  },
  {
    href: '/docs/theming',
    title: 'テーマ・動的配色',
    body: 'seed / scheme / contrast / mode による M3 動的配色。',
  },
  {
    href: '/docs/components',
    title: 'コンポーネント',
    body: 'Button、TextField、Dialog など全 API リファレンス。',
  },
  {
    href: '/docs/engines',
    title: 'スタイリングエンジン',
    body: 'Tailwind v4 と vanilla-extract の選び方と違い。',
  },
];

const installCode =
  'bun add @m3-baseui/react-tailwind @m3-baseui/tokens react react-dom @base-ui/react tailwindcss';
---

<SiteLayout title={title} description={description}>
  <!-- Hero -->
  <header class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 pt-16 pb-10 text-center">
    <p class="text-headline-large font-medium text-primary">m3-baseui</p>
    <h1 class="max-w-3xl text-display-small font-medium text-on-surface">
      Base UI 上の Material Design 3
    </h1>
    <p class="max-w-xl text-body-large text-on-surface-variant">
      {lead}
    </p>
    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/docs/getting-started"
        class="rounded-full bg-primary px-6 py-3 text-label-large text-on-primary transition-opacity hover:opacity-90"
      >
        導入ガイド
      </a>
      <a
        href="/docs/components"
        class="rounded-full border border-outline px-6 py-3 text-label-large text-primary transition-colors hover:bg-primary/8"
      >
        コンポーネント
      </a>
    </div>
    <p class="text-body-small text-on-surface-variant">
      <a
        class="text-primary underline"
        href="https://github.com/otomatty/m3-baseui"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub
      </a>
    </p>
  </header>

  <!-- Compact demo (React island) -->
  <section class="mx-auto max-w-5xl px-6 py-8" aria-labelledby="demo-heading">
    <h2 id="demo-heading" class="sr-only">ライブデモ</h2>
    <p class="mb-4 text-center text-body-medium text-on-surface-variant">
      右下のパレット FAB からテーマカラーを切り替えられます。
    </p>
    <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-4 sm:p-6">
      <LiveDemo client:visible />
    </div>
  </section>

  <!-- Next steps -->
  <section class="mx-auto max-w-5xl px-6 py-12" aria-labelledby="next-heading">
    <h2 id="next-heading" class="mb-6 text-headline-small text-on-surface">次のステップ</h2>
    <ul class="flex flex-col divide-y divide-outline-variant">
      {
        nextSteps.map((step) => (
          <li>
            <a
              class="group flex flex-col gap-1 py-5 transition-colors hover:text-primary sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              href={step.href}
            >
              <span class="text-title-medium text-on-surface group-hover:text-primary">
                {step.title}
              </span>
              <span class="text-body-medium text-on-surface-variant sm:text-right">
                {step.body}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Quick install -->
  <section id="install" class="mx-auto max-w-5xl px-6 py-12" aria-labelledby="install-heading">
    <h2 id="install-heading" class="mb-4 text-headline-small text-on-surface">
      クイックインストール
    </h2>
    <pre
      class="overflow-x-auto rounded-2xl bg-surface-container-highest p-5 text-body-medium text-on-surface"><code>{installCode}</code></pre>
    <p class="mt-4 text-body-medium text-on-surface-variant">
      詳しくは
      <a class="text-primary underline" href="/docs/getting-started">導入ガイド</a>
      を参照してください。
    </p>
  </section>
</SiteLayout>

---
import { GUIDE_LINKS, COMPONENT_GROUPS } from '../../config/docs-nav';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<aside
  class="docs-sidebar w-full shrink-0 border-b border-outline-variant bg-surface-container-low lg:w-64 lg:border-b-0 lg:border-r"
  aria-label="ドキュメント目次"
>
  <nav class="max-h-[40vh] overflow-y-auto p-4 lg:sticky lg:top-14 lg:max-h-[calc(100vh-3.5rem)] lg:py-6">
    <p class="mb-2 px-2 text-label-small text-on-surface-variant">ガイド</p>
    <ul class="mb-6 flex flex-col gap-0.5">
      {
        GUIDE_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-medium px-2 py-1.5 text-body-medium transition-colors',
                isActive(link.href)
                  ? 'bg-primary-container text-on-primary-container'
                  : 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      COMPONENT_GROUPS.map((group) => (
        <div class="mb-4">
          <p class="mb-1 px-2 text-label-small text-on-surface-variant">{group.title}</p>
          <ul class="flex flex-col gap-0.5">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-medium px-2 py-1.5 text-body-medium transition-colors',
                    isActive(item.href)
                      ? 'bg-primary-container text-on-primary-container'
                      : 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
